# Reverse-proxy de recette — HTTPS via Let's Encrypt sur recette.codabli.com.
#
# Caddy obtient et renouvelle le certificat automatiquement (ACME), termine le TLS,
# et redirige http://:80 vers https://:443. Il faut 80 ET 443 ouverts côté pare-feu
# OVH ET publiés par le service caddy du compose. Le challenge ACME HTTP-01 passe
# par le 80 : ne pas le fermer.

{
	admin off
	# email admin@codabli.com   # optionnel : notifications d'expiration Let's Encrypt
}

recette.codabli.com {
	# API backend (servie sous /api, pas de réécriture de chemin).
	handle /api/* {
		reverse_proxy backend:8082
	}

	# Keycloak (servi sous /auth).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Tout le reste : le front (SPA Angular servie par nginx).
	handle {
		reverse_proxy front:80
	}
}
