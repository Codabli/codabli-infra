# Config de la stack de recette. Copier vers .env SUR LA VM et renseigner.
# NE PAS committer .env (secrets). Voir .gitignore.

# URL publique de la recette. V1 = IP en HTTP. Plus tard : https://recette.codabli.fr
# Pilote à la fois l'issuer Keycloak et la validation des jetons côté backend.
PUBLIC_URL=http://51.178.223.90

# --- PostgreSQL (base applicative ; la base "keycloak" est créée à l'init) ---
POSTGRES_DB=codabli
POSTGRES_USER=codabli
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_fort

# --- Keycloak : compte admin initial ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_mot_de_passe_fort

# --- Secret du client Keycloak "codabli-backend" (injecté dans l'import du realm) ---
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_secret_client

# --- Images (utilisées par la CI ; en build local ces tags sont produits par --build) ---
BACKEND_IMAGE=ghcr.io/codabli/codabli-backend:recette
FRONT_IMAGE=ghcr.io/codabli/codabli-frontend:recette
